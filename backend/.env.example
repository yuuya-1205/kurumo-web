# このファイルをコピーして .env を作り、値を埋めて使う。
#   cp .env.example .env
# .env は .gitignore 済み（パスワードをコミットしないこと）。

PORT=8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kurumo_api

# silent / error / warn / info
# info にすると発行された SQL がすべてログに出る。
DB_LOG_LEVEL=warn

# JWT の署名鍵（HS256）。既定値は無く、未設定だとサーバーは起動しない。
# 環境ごとに十分に長いランダム文字列を入れること。例:
#   openssl rand -base64 48
JWT_SECRET=

# 発行するトークンの有効期間（時間）。未設定なら 24。
JWT_EXPIRY_HOURS=24
